# Wiz API credentials and tenant GraphQL endpoint
WIZ_API_URL=https://api.<your-tenant>.app.wiz.io/graphql
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_AUDIENCE=wiz-api

# PostgreSQL and Grafana read-only credentials
POSTGRES_DB=wiz_monitor
POSTGRES_USER=wiz_monitor
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
GRAFANA_BIND_ADDRESS=127.0.0.1

# Collector tuning
WIZ_PAGE_SIZE=100
SYNC_INTERVAL_SECONDS=900
